        "def clean_distribution_centers(raw):\n",
        "    df_dc_clean = raw.copy()\n",
        "    dc_log = []\n",
        "\n",
        "    def log(issue, action, reason, count, status=\"Applied\"):\n",
        "        dc_log.append({\n",
        "            \"Issue\": issue,\n",
        "            \"Cleaning Decision\": action,\n",
        "            \"Justification\": reason,\n",
        "            \"Rows Affected\": int(count),\n",
        "            \"Status\": status\n",
        "        })\n",
        "\n",
        "    # 1 removing exact duplicates\n",
        "    duplicate_count = df_dc_clean.duplicated().sum()\n",
        "    df_dc_clean = df_dc_clean.drop_duplicates().copy()\n",
        "\n",
        "    log(\n",
        "        \"Exact duplicate records\",\n",
        "        \"Remove exact duplicates if present\",\n",
        "        \"Prevent double-counting distribution centers\",\n",
        "        duplicate_count,\n",
        "        \"Applied\" if duplicate_count else \"Checked: none\"\n",
        "    )\n",
        "\n",
        "    # 2 duplicate DC IDs\n",
        "    duplicate_ids = df_dc_clean[\"dc_id\"].duplicated().sum()\n",
        "\n",
        "    if duplicate_ids:\n",
        "        raise ValueError(\"Duplicate distribution center IDs require review\")\n",
        "\n",
        "    log(\n",
        "        \"Duplicate DC identifiers\",\n",
        "        \"Verify each distribution center has a unique ID\",\n",
        "        \"Preserve reliable identifiers for future analysis\",\n",
        "        duplicate_ids,\n",
        "        \"Checked: none\"\n",
        "    )\n",
        "\n",
        "    # 3 approximate surge capacity\n",
        "    original_capacity = (\n",
        "        df_dc_clean[\"surge_capacity\"].astype(\"string\").str.strip()\n",
        "    )\n",
        "\n",
        "    df_dc_clean[\"approximate_surge_capacity\"] = (\n",
        "        original_capacity.str.startswith(\"~\").fillna(False)\n",
        "    )\n",
        "\n",
        "    approximate_count = (\n",
        "        df_dc_clean[\"approximate_surge_capacity\"].sum()\n",
        "    )\n",
        "\n",
        "    # 4 surge capacity to numeric\n",
        "    df_dc_clean[\"surge_capacity\"] = pd.to_numeric(\n",
        "        original_capacity.str.replace(\"~\", \"\", regex=False),\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    log(\n",
        "        \"Surge capacity stored as text\",\n",
        "        \"Convert capacity values to numeric estimates\",\n",
        "        \"Enable calculations using distribution center capacity\",\n",
        "        df_dc_clean[\"surge_capacity\"].notna().sum()\n",
        "    )\n",
        "\n",
        "    log(\n",
        "        \"Approximate surge capacity\",\n",
        "        \"Convert ~750 to 750 and flag as approximate\",\n",
        "        \"Preserve uncertainty associated with estimated capacity\",\n",
        "        approximate_count,\n",
        "        \"Flagged\"\n",
        "    )\n",
        "\n",
        "    # 5 flagging missing shipment costs\n",
        "    df_dc_clean[\"missing_shipment_cost\"] = (\n",
        "        df_dc_clean[\"cost_per_shipment\"].isna()\n",
        "    )\n",
        "\n",
        "    log(\n",
        "        \"Missing shipment costs\",\n",
        "        \"Retain missing costs and flag affected centers\",\n",
        "        \"Avoid inventing unsupported shipping costs\",\n",
        "        df_dc_clean[\"missing_shipment_cost\"].sum(),\n",
        "        \"Flagged\"\n",
        "    )\n",
        "\n",
        "    # 6 verifying state abbreviations\n",
        "    valid_states = {\"FL\", \"GA\", \"TX\", \"AL\"}\n",
        "\n",
        "    df_dc_clean[\"state\"] = (\n",
        "        df_dc_clean[\"state\"].astype(\"string\").str.strip().str.upper()\n",
        "    )\n",
        "\n",
        "    invalid_states = set(\n",
        "        df_dc_clean[\"state\"].dropna()\n",
        "    ) - valid_states\n",
        "\n",
        "    if invalid_states:\n",
        "        raise ValueError(f\"Unexpected states: {invalid_states}\")\n",
        "\n",
        "    log(\n",
        "        \"State abbreviation consistency\",\n",
        "        \"Verify standard two-letter state abbreviations\",\n",
        "        \"Maintain consistent geographic identifiers\",\n",
        "        0,\n",
        "        \"Verified\"\n",
        "    )\n",
        "\n",
        "    return df_dc_clean, pd.DataFrame(dc_log)\n",
        "\n",
        "\n",
        "df_dc_clean, dc_decision_log = clean_distribution_centers(\n",
        "    df_dc_original\n",
