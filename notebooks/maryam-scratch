      "source": [
        "step 6a: fixing the unmatched sku situation"
      ],
      "metadata": {
        "id": "ZzQ0M2PRbq9T"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# getting valid product catalog sku\n",
        "valid_skus = set(\n",
        "    df_product_clean[\"sku\"]\n",
        "    .astype(\"string\")\n",
        "    .str.strip()\n",
        "    .str.upper()\n",
        ")\n",
        "\n",
        "# finding records with no matching catalog SKU\n",
        "df_inventory_clean[\"unmatched_sku\"] = (\n",
        "    ~df_inventory_clean[\"sku\"].isin(valid_skus)\n",
        ")\n",
        "\n",
        "# creating inventory dataset for catalog-linked analysis\n",
        "df_inventory_matched = df_inventory_clean[\n",
        "    ~df_inventory_clean[\"unmatched_sku\"]\n",
        "].copy()\n",
        "\n",
        "# saving unmatched records separately for review\n",
        "df_inventory_unmatched = df_inventory_clean[\n",
        "    df_inventory_clean[\"unmatched_sku\"]\n",
        "].copy()\n",
        "\n",
        "# results\n",
        "print(\"Original inventory records:\", len(df_inventory_clean))\n",
        "print(\"Catalog-matched records:\", len(df_inventory_matched))\n",
        "print(\"Unmatched records retained for review:\", len(df_inventory_unmatched))\n",
        "print(\"\\nUnmatched SKU counts:\")\n",
        "print(df_inventory_unmatched[\"sku\"].value_counts())\n",
        "\n",
        "# were any records lost? checking that\n",
        "assert (\n",
        "    len(df_inventory_matched) + len(df_inventory_unmatched)\n",
        "    == len(df_inventory_clean)\n",
        ")\n",
        "assert df_inventory_matched[\"sku\"].isin(valid_skus).all()\n",
        "print(\"\\nSKU separation verified!\")"
      ],
