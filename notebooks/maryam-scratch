      "source": [
        "# adjusting sku values for comparison w/o changing originals\n",
        "transaction_skus = (\n",
        "    df_clean[\"sku\"].astype(\"string\").str.strip().str.upper()\n",
        ")\n",
        "\n",
        "catalog_skus = (\n",
        "    df_product_clean[\"sku\"].astype(\"string\").str.strip().str.upper()\n",
        ")\n",
        "\n",
        "# comparing unique skus\n",
        "transaction_set = set(transaction_skus.dropna())\n",
        "catalog_set = set(catalog_skus.dropna())\n",
        "print(\"Unique transaction SKUs:\", len(transaction_set))\n",
        "print(\"Unique catalog SKUs:\", len(catalog_set))\n",
        "print(\"\\nTransaction SKUs missing from catalog:\")\n",
        "print(sorted(transaction_set - catalog_set))\n",
        "print(\"\\nCatalog SKUs missing from transactions:\")\n",
        "print(sorted(catalog_set - transaction_set))\n",
        "# count the affected transaction records\n",
        "unmatched_mask = ~transaction_skus.isin(catalog_set)\n",
        "print(\"\\nTransaction records with unmatched SKUs:\")\n",
        "print(int(unmatched_mask.sum()))\n",
        "\n",
        "\n",
        "print(\"\\nUnmatched SKU counts:\")\n",
        "print(transaction_skus[unmatched_mask].value_counts())\n"
