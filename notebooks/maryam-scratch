        "step 3: cleaning store locations"
      ],
      "metadata": {
        "id": "Zjy2xUcjx1km"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "def clean_store_locations(raw):\n",
        "    df_store_clean = raw.copy()\n",
        "    store_log = []\n",
        "\n",
        "    def log(issue, action, reason, count, status=\"Applied\"):\n",
        "        store_log.append({\n",
        "            \"Issue\": issue,\n",
        "            \"Cleaning Decision\": action,\n",
        "            \"Justification\": reason,\n",
        "            \"Rows Affected\": int(count),\n",
        "            \"Status\": status\n",
        "        })\n",
        "\n",
        "    # 1 checking duplicates\n",
        "    exact_duplicates = df_store_clean.duplicated().sum()\n",
        "    df_store_clean = df_store_clean.drop_duplicates().copy()\n",
        "\n",
        "    log(\n",
        "        \"Exact duplicate records\",\n",
        "        \"Remove exact duplicates if present\",\n",
        "        \"Prevent duplicate store records\",\n",
        "        exact_duplicates,\n",
        "        \"Applied\" if exact_duplicates else \"Checked: none\"\n",
        "    )\n",
        "\n",
        "    # 2 standardizing store IDs\n",
        "    original_ids = df_store_clean[\"store_id\"].copy()\n",
        "\n",
        "    df_store_clean[\"store_id\"] = (\n",
        "        df_store_clean[\"store_id\"]\n",
        "        .astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.upper()\n",
        "        .str.replace(\"_\", \"-\", regex=False)\n",
        "        .str.replace(r\"^FL(\\d{3})$\", r\"FL-\\1\", regex=True)\n",
        "    )\n",
        "\n",
        "    changed_ids = (\n",
        "        original_ids.astype(\"string\") != df_store_clean[\"store_id\"]\n",
        "    ).sum()\n",
        "\n",
        "    log(\n",
        "        \"Inconsistent store IDs\",\n",
        "        \"Standardize IDs to FL-XXX format\",\n",
        "        \"Ensure consistency with Walmart transactions\",\n",
        "        changed_ids\n",
        "    )\n",
        "\n",
        "    # 3 removing duplicate stores after ID step 2\n",
        "    # confirming repeated IDs have matching store details\n",
        "    repeated = df_store_clean[\n",
        "        df_store_clean.duplicated(\"store_id\", keep=False)\n",
        "    ]\n",
        "\n",
        "    for store_id, group in repeated.groupby(\"store_id\"):\n",
        "        details = group.drop(columns=[\"store_id\"]).fillna(\"MISSING\")\n",
        "        if len(details.drop_duplicates()) != 1:\n",
        "            raise ValueError(\n",
        "                f\"Conflicting records for store {store_id}\"\n",
        "            )\n",
        "\n",
        "    duplicate_stores = df_store_clean.duplicated(\"store_id\").sum()\n",
        "\n",
        "    df_store_clean = df_store_clean.drop_duplicates(\n",
        "        subset=\"store_id\",\n",
        "        keep=\"first\"\n",
        "    ).copy()\n",
        "\n",
        "    log(\n",
        "        \"Duplicate store records\",\n",
        "        \"Remove identical stores with equivalent IDs\",\n",
        "        \"Ensure each physical store appears once\",\n",
        "        duplicate_stores\n",
        "    )\n",
        "\n",
        "    # 4 standardizing state names\n",
        "    original_states = df_store_clean[\"state\"].copy()\n",
        "\n",
        "    state_map = {\n",
        "        \"FL\": \"FL\",\n",
        "        \"FLORIDA\": \"FL\",\n",
        "        \"FLA.\": \"FL\"\n",
        "    }\n",
        "\n",
        "    state_values = (\n",
        "        df_store_clean[\"state\"].astype(\"string\").str.strip().str.upper()\n",
        "    )\n",
        "\n",
        "    unknown_states = set(state_values.dropna()) - set(state_map)\n",
        "    if unknown_states:\n",
        "        raise ValueError(f\"Unknown state values: {unknown_states}\")\n",
        "\n",
        "    df_store_clean[\"state\"] = state_values.map(state_map)\n",
        "\n",
        "    changed_states = (\n",
        "        original_states.astype(\"string\") != df_store_clean[\"state\"]\n",
        "    ).sum()\n",
        "\n",
        "    log(\n",
        "        \"Inconsistent state names\",\n",
        "        \"Standardize Florida variations to FL\",\n",
        "        \"Ensure consistent geographic identifiers\",\n",
        "        changed_states\n",
        "    )\n",
        "\n",
        "    # 5 standardizing region names\n",
        "    original_regions = df_store_clean[\"region\"].copy()\n",
        "\n",
        "    df_store_clean[\"region\"] = (\n",
        "        df_store_clean[\"region\"]\n",
        "        .astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.title()\n",
        "    )\n",
        "\n",
        "    changed_regions = (\n",
        "        original_regions.astype(\"string\") != df_store_clean[\"region\"]\n",
        "    ).sum()\n",
        "\n",
        "    log(\n",
        "        \"Inconsistent region formatting\",\n",
        "        \"Remove extra spaces and standardize capitalization\",\n",
        "        \"Prevent identical regions from being counted separately\",\n",
        "        changed_regions\n",
        "    )\n",
        "\n",
        "    # 6 converting zip codes to be five characters\n",
        "    df_store_clean[\"zip_code\"] = (\n",
        "        df_store_clean[\"zip_code\"]\n",
        "        .astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.zfill(5)\n",
        "    )\n",
        "\n",
        "    log(\n",
        "        \"ZIP code data type\",\n",
        "        \"Convert ZIP codes from integers to five-character strings\",\n",
        "        \"Preserve leading zeros and treat ZIP codes as identifiers\",\n",
        "        df_store_clean[\"zip_code\"].notna().sum()\n",
        "    )\n",
        "\n",
        "    # 7 finding missing coordinates\n",
        "    df_store_clean[\"missing_coordinates\"] = (\n",
        "        df_store_clean[\"latitude\"].isna() |\n",
        "        df_store_clean[\"longitude\"].isna()\n",
        "    )\n",
        "\n",
        "    log(\n",
        "        \"Missing geographic coordinates\",\n",
        "        \"Retain stores and flag missing latitude or longitude\",\n",
        "        \"Avoid inventing geographic coordinates\",\n",
        "        df_store_clean[\"missing_coordinates\"].sum(),\n",
        "        \"Flagged\"\n",
        "    )\n",
        "\n",
        "    return df_store_clean.reset_index(drop=True), pd.DataFrame(store_log)\n",
        "\n",
        "\n",
        "# running\n",
        "df_store_clean, store_decision_log = clean_store_locations(\n",
        "    df_store_original\n",
        ")\n",
        "\n",
        "print(\"Cleaning complete!\")\n",
        "print(\"Original rows:\", len(df_store_original))\n",
        "print(\"Cleaned rows:\", len(df_store_clean))\n"
      ],
