        "        log.append({\n",
        "            \"Issue\": issue,\n",
        "            \"Cleaning Decision\": decision,\n",
        "            \"Justification\": reason,\n",
        "            \"Rows Affected\": int(count),\n",
        "            \"Status\": status\n",
        "        })\n",
        "\n",
        "    # 1 removing exact duplicates\n",
        "    n = clean.duplicated().sum()\n",
        "    clean = clean.drop_duplicates().copy()\n",
        "    record(\n",
        "        \"Exact duplicates\",\n",
        "        \"Remove exact duplicates\",\n",
        "        \"Prevent duplicate inventory records\",\n",
        "        n,\n",
        "        \"Applied\" if n else \"Checked: none\"\n",
        "    )\n",
        "\n",
        "    # 2 chanigng dates\n",
        "    clean[\"date\"] = pd.to_datetime(\n",
        "        clean[\"date\"], errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    record(\n",
        "        \"Date data type\",\n",
        "        \"Convert valid dates to datetime\",\n",
        "        \"Support daily inventory analysis\",\n",
        "        clean[\"date\"].notna().sum()\n",
        "    )\n",
        "\n",
        "    # 3 standardizing store ids\n",
        "    old = clean[\"store_id\"].astype(\"string\")\n",
        "    clean[\"store_id\"] = (\n",
        "        clean[\"store_id\"]\n",
        "        .astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.upper()\n",
        "        .str.replace(\"_\", \"-\", regex=False)\n",
        "        .str.replace(r\"^FL(\\d{3})$\", r\"FL-\\1\", regex=True)\n",
        "    )\n",
        "\n",
        "    record(\n",
        "        \"Store ID formatting\",\n",
        "        \"Standardize IDs to FL-XXX format\",\n",
        "        \"Ensure consistent store identifiers\",\n",
        "        (old != clean[\"store_id\"]).sum()\n",
        "    )\n",
        "\n",
        "    # 4 SKU formatting\n",
        "    old = clean[\"sku\"].astype(\"string\")\n",
        "\n",
        "    clean[\"sku\"] = (\n",
        "        clean[\"sku\"]\n",
        "        .astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.upper()\n",
        "    )\n",
        "\n",
        "    record(\n",
        "        \"SKU formatting\",\n",
        "        \"Standardize whitespace and capitalization\",\n",
        "        \"Improve matching without merging products\",\n",
        "        (old != clean[\"sku\"]).sum()\n",
        "    )\n",
        "\n",
        "    # 5 missing units on order\n",
        "    clean[\"missing_units_on_order\"] = (\n",
        "        clean[\"units_on_order\"].isna()\n",
        "    )\n",
        "\n",
        "    record(\n",
        "        \"Missing units on order\",\n",
        "        \"Retain and flag missing values\",\n",
        "        \"Missing values do not necessarily mean zero\",\n",
        "        clean[\"missing_units_on_order\"].sum(),\n",
        "        \"Flagged\"\n",
        "    )\n",
        "\n",
        "    # 6 flagging negative inventory quantities\n",
        "    for col in [\n",
        "        \"units_on_hand\",\n",
        "        \"units_on_order\",\n",
        "        \"reorder_point\"\n",
        "    ]:\n",
        "        clean[f\"negative_{col}\"] = clean[col] < 0\n",
        "\n",
        "        n = clean[f\"negative_{col}\"].sum()\n",
        "\n",
        "        record(\n",
        "            f\"Negative {col}\",\n",
        "            \"Flag negative values\",\n",
        "            \"Investigate potentially invalid inventory values\",\n",
        "            n,\n",
        "            \"Flagged\" if n else \"Checked: none\"\n",
        "        )\n",
        "\n",
        "    return clean.reset_index(drop=True), pd.DataFrame(log)\n",
