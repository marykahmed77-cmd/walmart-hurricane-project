    {
      "cell_type": "code",
      "source": [
        "def clean_daily_sales(raw):\n",
        "    clean = raw.copy()\n",
        "    log = []\n",
        "    def record(issue, decision, reason, count, status=\"Applied\"):\n",
        "        log.append({\n",
        "            \"Issue\": issue,\n",
        "            \"Cleaning Decision\": decision,\n",
        "            \"Justification\": reason,\n",
        "            \"Rows Affected\": int(count),\n",
        "            \"Status\": status\n",
        "        })\n",
        "\n",
        "    # 1 removing exact duplicates\n",
        "    n = clean.duplicated().sum()\n",
        "    clean = clean.drop_duplicates().copy()\n",
        "\n",
        "    record(\n",
        "        \"Exact duplicates\",\n",
        "        \"Remove exact duplicates\",\n",
        "        \"Prevent double-counting sales\",\n",
        "        n,\n",
        "        \"Applied\" if n else \"Checked: none\"\n",
        "    )\n",
        "\n",
        "    # 2 chanigng mixed date formats\n",
        "    original_dates = clean[\"date\"].astype(\"string\").str.strip()\n",
        "\n",
        "    alternate_dates = original_dates.str.fullmatch(\n",
        "        r\"\\d{8}\"\n",
        "    ).fillna(False)\n",
        "\n",
        "    clean[\"date\"] = pd.to_datetime(\n",
        "        original_dates,\n",
        "        format=\"mixed\",\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    record(\n",
        "        \"Date data type\",\n",
        "        \"Convert valid dates to datetime\",\n",
        "        \"Enable time-based analysis\",\n",
        "        clean[\"date\"].notna().sum()\n",
        "    )\n",
        "\n",
        "    recovered_dates = (\n",
        "        alternate_dates & clean[\"date\"].notna()\n",
        "    ).sum()\n",
        "\n",
        "    record(\n",
        "        \"Mixed date formats\",\n",
        "        \"Parse YYYY-MM-DD and YYYYMMDD date formats\",\n",
        "        \"Recover valid dates and support accurate daily analysis\",\n",
        "        recovered_dates\n",
        "    )\n",
        "\n",
        "    # flagging invalid dates\n",
        "    clean[\"invalid_date\"] = clean[\"date\"].isna()\n",
        "\n",
        "    record(\n",
        "        \"Invalid dates\",\n",
        "        \"Retain and flag any unparseable dates\",\n",
        "        \"Avoid inventing dates or deleting valid sales data\",\n",
        "        clean[\"invalid_date\"].sum(),\n",
        "        \"Flagged\" if clean[\"invalid_date\"].sum() else \"Checked: none\"\n",
        "    )\n",
        "\n",
        "    # 3 store IDs\n",
        "    old = clean[\"store_id\"].astype(\"string\")\n",
        "\n",
        "    clean[\"store_id\"] = (\n",
        "        clean[\"store_id\"]\n",
        "        .astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.upper()\n",
        "        .str.replace(\"_\", \"-\", regex=False)\n",
        "        .str.replace(r\"^FL(\\d{3})$\", r\"FL-\\1\", regex=True)\n",
        "    )\n",
        "\n",
        "    record(\n",
        "        \"Store ID formatting\",\n",
        "        \"Standardize IDs to FL-XXX format\",\n",
        "        \"Ensure compatibility with Store Locations\",\n",
        "        (old != clean[\"store_id\"]).sum()\n",
        "    )\n",
        "\n",
        "    # 4 cleaning categories\n",
        "    category_map = {\n",
        "        \"grocery\": \"Grocery\",\n",
        "        \"groceries\": \"Grocery\",\n",
        "        \"household\": \"Household\",\n",
        "        \"household essentials\": \"Household\",\n",
        "        \"electronics\": \"Electronics\",\n",
        "        \"alcohol\": \"Alcohol\",\n",
        "        \"alcoholic beverages\": \"Alcohol\",\n",
        "        \"snacks\": \"Snacks\",\n",
        "        \"emergency\": \"Emergency\",\n",
        "        \"emergency supplies\": \"Emergency\",\n",
        "        \"entertainment\": \"Entertainment\",\n",
        "        \"games & entertainment\": \"Entertainment\",\n",
        "        \"health\": \"Health\",\n",
        "        \"health & wellness\": \"Health\",\n",
        "        \"breakfast\": \"Breakfast\",\n",
        "        \"breakfast foods\": \"Breakfast\",\n",
        "        \"baby\": \"Baby\",\n",
        "        \"baby products\": \"Baby\"\n",
        "    }\n",
        "\n",
        "    old = clean[\"category\"].astype(\"string\")\n",
        "    normalized = old.str.strip().str.lower()\n",
        "    unknown = set(normalized.dropna()) - set(category_map)\n",
        "    if unknown:\n",
        "        raise ValueError(f\"Unmapped categories: {unknown}\")\n",
        "    clean[\"category\"] = normalized.map(category_map)\n",
        "    record(\n",
        "        \"Category formatting\",\n",
        "        \"Use standardized category labels\",\n",
        "        \"Ensure consistency with other datasets\",\n",
        "        (old != clean[\"category\"]).sum()\n",
        "    )\n",
        "\n",
        "    # 5 is there negative revenue\n",
        "    clean[\"negative_revenue\"] = clean[\"total_revenue\"] < 0\n",
        "\n",
        "    record(\n",
        "        \"Negative revenue\",\n",
        "        \"Retain and flag negative revenue\",\n",
        "        \"May represent refunds or accounting adjustments\",\n",
        "        clean[\"negative_revenue\"].sum(),\n",
        "        \"Flagged\"\n",
        "    )\n",
        "\n",
        "    # 6 invalid total units\n",
        "    clean[\"invalid_total_units\"] = (\n",
        "        clean[\"total_units\"].isna() |\n",
        "        (clean[\"total_units\"] < 0)\n",
        "    )\n",
        "    n = clean[\"invalid_total_units\"].sum()\n",
        "    record(\n",
        "        \"Invalid total units\",\n",
        "        \"Flag missing or negative values\",\n",
        "        \"Avoid unsupported corrections\",\n",
        "        n,\n",
        "        \"Flagged\" if n else \"Checked: none\"\n",
        "    )\n",
        "    return clean.reset_index(drop=True), pd.DataFrame(log)\n",
        "df_sales_clean, sales_decision_log = clean_daily_sales(\n",
        "    df_sales_original\n",
        ")\n",
        "\n",
        "print(\"Daily Sales cleaning complete!\")\n",
        "print(\"Original rows:\", len(df_sales_original))\n",
        "print(\"Cleaned rows:\", len(df_sales_clean))\n",
        "print(\"Alternate-format dates recovered:\",\n",
        "      int(recovered_dates) if False else\n",
        "      int(sales_decision_log.loc[\n",
        "          sales_decision_log[\"Issue\"] == \"Mixed date formats\",\n",
        "          \"Rows Affected\"\n",
        "      ].iloc[0]))\n",
        "print(\"Invalid dates remaining:\", df_sales_clean[\"invalid_date\"].sum())"
      ],
