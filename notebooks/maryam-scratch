        "step 3: cleaning product_catalog"
      ],
      "metadata": {
        "id": "NxTvFeB_uhHL"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import re\n",
        "def clean_product_catalog(raw):\n",
        "    df_product_clean = raw.copy()\n",
        "    product_log = []\n",
        "\n",
        "    def log(issue, action, reason, count, status=\"Applied\"):\n",
        "        product_log.append({\n",
        "            \"Issue\": issue,\n",
        "            \"Cleaning Decision\": action,\n",
        "            \"Justification\": reason,\n",
        "            \"Rows Affected\": int(count),\n",
        "            \"Status\": status\n",
        "        })\n",
        "\n",
        "    # 1 removing exact duplicates\n",
        "    duplicates = df_product_clean.duplicated().sum()\n",
        "    df_product_clean = df_product_clean.drop_duplicates().copy()\n",
        "\n",
        "    log(\n",
        "        \"Exact duplicates\",\n",
        "        \"Remove exact duplicate records\",\n",
        "        \"Prevent duplicate catalog entries\",\n",
        "        duplicates,\n",
        "        \"Applied\" if duplicates else \"Checked: none\"\n",
        "    )\n",
        "\n",
        "    # 2 standarize category labels\n",
        "    category_map = {\n",
        "        \"grocery\": \"Grocery\",\n",
        "        \"groceries\": \"Grocery\",\n",
        "        \"household\": \"Household\",\n",
        "        \"household essentials\": \"Household\",\n",
        "        \"electronics\": \"Electronics\",\n",
        "        \"alcohol\": \"Alcohol\",\n",
        "        \"alcoholic beverages\": \"Alcohol\",\n",
        "        \"snacks\": \"Snacks\",\n",
        "        \"emergency\": \"Emergency\",\n",
        "        \"emergency supplies\": \"Emergency\",\n",
        "        \"entertainment\": \"Entertainment\",\n",
        "        \"games & entertainment\": \"Entertainment\",\n",
        "        \"health\": \"Health\",\n",
        "        \"health & wellness\": \"Health\",\n",
        "        \"breakfast\": \"Breakfast\",\n",
        "        \"breakfast foods\": \"Breakfast\",\n",
        "        \"baby\": \"Baby\",\n",
        "        \"baby products\": \"Baby\"\n",
        "    }\n",
        "\n",
        "    old_categories = df_product_clean[\"category\"].copy()\n",
        "\n",
        "    categories = (\n",
        "        df_product_clean[\"category\"]\n",
        "        .astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.lower()\n",
        "    )\n",
        "\n",
        "    unknown = set(categories.dropna()) - set(category_map)\n",
        "    if unknown:\n",
        "        raise ValueError(f\"Unmapped categories: {unknown}\")\n",
        "\n",
        "    df_product_clean[\"category\"] = categories.map(category_map)\n",
        "\n",
        "    changed = (\n",
        "        old_categories.astype(\"string\") !=\n",
        "        df_product_clean[\"category\"]\n",
        "    ).sum()\n",
        "\n",
        "    log(\n",
        "        \"Inconsistent categories\",\n",
        "        \"Standardize category names to match transactions\",\n",
        "        \"Ensure consistent grouping and joins\",\n",
        "        changed\n",
        "    )\n",
        "\n",
        "    # 3. Standardize product name formatting\n",
        "    old_names = df_product_clean[\"product_name\"].copy()\n",
        "\n",
        "    df_product_clean[\"product_name\"] = (\n",
        "        df_product_clean[\"product_name\"]\n",
        "        .astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.replace(r\"\\s+\", \" \", regex=True)\n",
        "        .str.title()\n",
        "    )\n",
        "\n",
        "    changed_names = (\n",
        "        old_names.astype(\"string\") !=\n",
        "        df_product_clean[\"product_name\"]\n",
        "    ).sum()\n",
        "\n",
        "    log(\n",
        "        \"Inconsistent product name formatting\",\n",
        "        \"Standardize whitespace and title capitalization\",\n",
        "        \"Improve consistency without merging product identities\",\n",
        "        changed_names\n",
        "    )\n",
        "\n",
        "    # 4 standarize package-size formatting\n",
        "    old_packages = df_product_clean[\"package_size\"].copy()\n",
        "\n",
        "    def clean_package(value):\n",
        "        if pd.isna(value):\n",
        "            return pd.NA\n",
        "\n",
        "        value = str(value).strip().lower()\n",
        "        value = value.replace(\"–\", \"-\").replace(\"—\", \"-\")\n",
        "\n",
        "        if value in [\"single\", \"bundle\"]:\n",
        "            return value\n",
        "\n",
        "        match = re.fullmatch(\n",
        "            r\"(\\d+)\\s*-?\\s*(?:pack|pk)\",\n",
        "            value\n",
        "        )\n",
        "\n",
        "        if match:\n",
        "            return f\"{int(match.group(1))}-pack\"\n",
        "\n",
        "        return value\n",
        "\n",
        "    df_product_clean[\"package_size\"] = (\n",
        "        df_product_clean[\"package_size\"].apply(clean_package)\n",
        "    )\n",
        "\n",
        "    changed_packages = (\n",
        "        old_packages.astype(\"string\") !=\n",
        "        df_product_clean[\"package_size\"].astype(\"string\")\n",
        "    ).sum()\n",
        "\n",
        "    log(\n",
        "        \"Inconsistent package-size formats\",\n",
        "        \"Standardize numeric pack labels to N-pack\",\n",
        "        \"Make equivalent packaging formats consistent\",\n",
        "        changed_packages\n",
        "    )\n",
        "\n",
        "    # 5 checking and flag missing unit costs\n",
        "    df_product_clean[\"unit_cost\"] = pd.to_numeric(\n",
        "        df_product_clean[\"unit_cost\"],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    df_product_clean[\"missing_unit_cost\"] = (\n",
        "        df_product_clean[\"unit_cost\"].isna()\n",
        "    )\n",
        "\n",
        "    log(\n",
        "        \"Missing unit costs\",\n",
        "        \"Retain and flag records with missing costs\",\n",
        "        \"Avoid inventing supplier or product costs\",\n",
        "        df_product_clean[\"missing_unit_cost\"].sum(),\n",
        "        \"Flagged\"\n",
        "    )\n",
        "\n",
        "    # 6 checking duplicate SKUs\n",
        "    duplicate_skus = df_product_clean[\"sku\"].duplicated().sum()\n",
        "\n",
        "    log(\n",
        "        \"Duplicate SKU identifiers\",\n",
        "        \"Check SKU uniqueness; preserve distinct identifiers\",\n",
        "        \"Avoid incorrectly combining different product records\",\n",
        "        duplicate_skus,\n",
        "        \"Review\" if duplicate_skus else \"Checked: none\"\n",
        "    )\n",
        "\n",
        "    # 7 preserving supplier information\n",
        "    log(\n",
        "        \"Supplier inconsistencies\",\n",
        "        \"Retain original supplier values pending verification\",\n",
        "        \"Supplier identity cannot be inferred from product name\",\n",
        "        0,\n",
        "        \"Pending review\"\n",
        "    )\n",
        "\n",
        "    # 8 preserving SKU mappings\n",
        "    log(\n",
        "        \"Potentially equivalent product SKUs\",\n",
        "        \"Keep original SKUs pending pack-size and cost review\",\n",
        "        \"Prevent incorrect merging of distinct catalog items\",\n",
        "        0,\n",
        "        \"Pending SKU review\"\n",
        "    )\n",
        "\n",
        "    return df_product_clean, pd.DataFrame(product_log)\n",
        "\n",
        "\n",
        "df_product_clean, product_decision_log = (\n",
        "    clean_product_catalog(df_product_original)\n",
        ")\n",
        "print(\"Cleaning complete!\")\n",
        "print(\"Original rows:\", len(df_product_original))\n",
        "print(\"Cleaned rows:\", len(df_product_clean))"
      ],
