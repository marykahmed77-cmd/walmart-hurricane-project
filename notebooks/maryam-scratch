        "df_inventory_clean[\"unmatched_sku\"] = (\n",
        "    ~df_inventory_clean[\"sku\"].isin(catalog_skus)\n",
        ")\n",
        "unmatched_count = int(df_inventory_clean[\"unmatched_sku\"].sum())\n",
        "print(\"Unmatched inventory records:\", unmatched_count)\n",
        "print(\"\\nUnmatched SKUs:\")\n",
        "print(sorted(\n",
